# UID del host: evita que Airflow escriba logs como root en los volúmenes montados.
AIRFLOW_UID=501

# Credenciales de la UI de Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Clave de cifrado de conexiones de Airflow (para clase; en producción se genera y se guarda aparte)
FERNET_KEY=

# Credenciales de MinIO (almacén S3 local)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Nombres compartidos entre servicios
NOMBRE_MODELO=iris_xgboost
EXPERIMENTO=iris_pycaret
RED_DOCKER=mlops_red
IMAGEN_ENTRENADOR=mlops-iris/entrenador:latest
